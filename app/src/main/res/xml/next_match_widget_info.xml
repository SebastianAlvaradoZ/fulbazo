<?xml version="1.0" encoding="utf-8"?>
<!-- Por defecto 4x2; se puede achicar a 2x2 y agrandar. WorkManager trae los datos cada 15 min; cada 30 el
     sistema lo redibuja aunque no haya red, para quitar los partidos que ya empezaron. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="530dp"
    android:maxResizeHeight="450dp"
    android:previewImage="@drawable/ic_fulbazo_logo"
    android:previewLayout="@layout/widget_next_match_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
