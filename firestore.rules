rules_version = '2';

// Reglas de seguridad de Firestore para Fulbazo.
// Se publican en la consola: Firestore Database → Reglas → pegar → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isOwner(userId) {
      return signedIn() && uid() == userId;
    }

    function matchData(matchId) {
      return get(/databases/$(database)/documents/partidos/$(matchId)).data;
    }

    function invitationExists(invitationId) {
      return exists(/databases/$(database)/documents/invitaciones/$(invitationId));
    }

    function commentData(commentId) {
      return get(/databases/$(database)/documents/comentarios/$(commentId)).data;
    }

    function commentExists(commentId) {
      return exists(/databases/$(database)/documents/comentarios/$(commentId));
    }

    function friendRequestExists(requestId) {
      return exists(/databases/$(database)/documents/solicitudesAmistad/$(requestId));
    }

    // Solo cambian los campos indicados.
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---------------------------------------------------------------- Jugadores

    // Perfil público: lo leen los jugadores con sesión; solo lo edita su dueño.
    match /usuarios/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId)
        && request.resource.data.apodo is string
        && request.resource.data.apodoMinusculas == request.resource.data.apodo.lower()
        // Foto comprimida dentro del documento (máx. ~300 KB).
        && (request.resource.data.get('foto', null) == null || request.resource.data.foto.size() < 300000);
      allow delete: if false;

      // Celular, correo y fecha de nacimiento: solo los ve su dueño.
      match /privado/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Reserva de apodos para que no se repitan. Se puede consultar sin sesión
    // (el registro revisa el apodo antes de crear la cuenta).
    match /apodos/{apodo} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == uid()
        && apodo == apodo.lower();
      allow delete: if signedIn() && resource.data.uid == uid();
      allow update: if false;
    }

    // ---------------------------------------------------------------- Partidos

    match /partidos/{matchId} {
      allow read: if signedIn();

      // Quien lo crea es el anfitrión y el primer jugador.
      allow create: if signedIn()
        && request.resource.data.anfitrionId == uid()
        && request.resource.data.jugadores == [uid()]
        && request.resource.data.estado == 'OPEN'
        && request.resource.data.cupos is int
        && request.resource.data.cupos >= 2 && request.resource.data.cupos <= 22
        && request.resource.data.descripcion.size() <= 200;

      // Solo cambian los jugadores (y el estado), sin pasarse de los cupos:
      // - el anfitrión agrega a quien aceptó o saca jugadores;
      // - un jugador invitado se agrega a sí mismo;
      // - un jugador (que no es el anfitrión) sale del partido.
      allow update: if signedIn()
        && onlyChanges(['jugadores', 'estado'])
        && request.resource.data.jugadores.size() <= resource.data.cupos
        && (
          uid() == resource.data.anfitrionId
          || (
            request.resource.data.jugadores.toSet() == resource.data.jugadores.toSet().union([uid()].toSet())
            && request.resource.data.jugadores.size() == resource.data.jugadores.size() + 1
            && invitationExists(matchId + '_' + uid())
          )
          || (
            uid() != resource.data.anfitrionId
            && request.resource.data.jugadores.toSet() == resource.data.jugadores.toSet().difference([uid()].toSet())
          )
        );

      allow delete: if false;
    }

    // Solicitudes para unirse: solicitudes/{partidoId}_{usuarioId}.
    match /solicitudes/{requestId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.usuarioId == uid()
        && requestId == request.resource.data.partidoId + '_' + uid()
        && request.resource.data.estado == 'PENDING'
        && request.resource.data.anfitrionId == matchData(request.resource.data.partidoId).anfitrionId;

      allow update: if signedIn() && (
        // El jugador vuelve a enviar una solicitud rechazada.
        (
          resource.data.usuarioId == uid()
          && request.resource.data.estado == 'PENDING'
          && request.resource.data.usuarioId == resource.data.usuarioId
          && request.resource.data.partidoId == resource.data.partidoId
          && request.resource.data.anfitrionId == resource.data.anfitrionId
        )
        // El anfitrión acepta o rechaza una solicitud pendiente.
        || (
          resource.data.anfitrionId == uid()
          && resource.data.estado == 'PENDING'
          && onlyChanges(['estado'])
          && request.resource.data.estado in ['ACCEPTED', 'REJECTED']
        )
      );

      // El jugador retira su solicitud mientras está pendiente.
      allow delete: if signedIn()
        && resource.data.usuarioId == uid()
        && resource.data.estado == 'PENDING';
    }

    // Invitaciones: invitaciones/{partidoId}_{invitadoId}.
    match /invitaciones/{invitationId} {
      // Cualquier jugador puede ver si alguien ya fue invitado a un partido
      // (para no invitarlo dos veces), pero solo lista las suyas.
      allow get: if signedIn();
      allow list: if signedIn()
        && (resource.data.paraId == uid() || resource.data.deId == uid());

      // Solo invita quien juega en el partido.
      allow create: if signedIn()
        && request.resource.data.deId == uid()
        && invitationId == request.resource.data.partidoId + '_' + request.resource.data.paraId
        && request.resource.data.estado == 'PENDING'
        && uid() in matchData(request.resource.data.partidoId).jugadores;

      // El invitado acepta o rechaza.
      allow update: if signedIn()
        && resource.data.paraId == uid()
        && onlyChanges(['estado'])
        && request.resource.data.estado in ['ACCEPTED', 'DECLINED'];

      allow delete: if false;
    }

    // ---------------------------------------------------------------- Amigos

    // Solicitudes de amistad: solicitudesAmistad/{deId}_{paraId}.
    match /solicitudesAmistad/{requestId} {
      allow get: if signedIn()
        && (resource == null || uid() in [resource.data.deId, resource.data.paraId]);
      allow list: if signedIn()
        && (resource.data.deId == uid() || resource.data.paraId == uid());

      allow create: if signedIn()
        && request.resource.data.deId == uid()
        && requestId == uid() + '_' + request.resource.data.paraId
        && request.resource.data.estado == 'PENDING';

      allow update: if signedIn() && (
        // Quien la envió la vuelve a enviar.
        (
          resource.data.deId == uid()
          && request.resource.data.deId == resource.data.deId
          && request.resource.data.paraId == resource.data.paraId
          && request.resource.data.estado == 'PENDING'
        )
        // Quien la recibió la acepta o la rechaza.
        || (
          resource.data.paraId == uid()
          && onlyChanges(['estado'])
          && request.resource.data.estado in ['ACCEPTED', 'REJECTED']
        )
      );

      allow delete: if signedIn()
        && (resource == null || uid() in [resource.data.deId, resource.data.paraId]);
    }

    // Amistades aceptadas: amistades/{a}_{b}.
    match /amistades/{pairId} {
      allow get: if signedIn()
        && (resource == null || uid() in resource.data.miembros);
      allow list: if signedIn() && uid() in resource.data.miembros;

      // La crea quien acepta una solicitud que de verdad le enviaron.
      allow create: if signedIn()
        && request.resource.data.paraId == uid()
        && request.resource.data.miembros == [request.resource.data.deId, uid()]
        && (pairId == request.resource.data.deId + '_' + uid() || pairId == uid() + '_' + request.resource.data.deId)
        && friendRequestExists(request.resource.data.deId + '_' + uid());

      allow update: if false;
      allow delete: if signedIn()
        && (resource == null || uid() in resource.data.miembros);
    }

    // Grupos de amigos: solo los ve y edita su dueño.
    match /grupos/{groupId} {
      allow read, update, delete: if signedIn() && resource.data.duenoId == uid();
      allow create: if signedIn()
        && request.resource.data.duenoId == uid()
        && request.resource.data.nombre.size() <= 30;
    }

    // ---------------------------------------------------------------- Estadísticas

    // Autoevaluación ("Cómo me veo"): la ven todos, la edita su dueño.
    match /estadisticas/{userId} {
      allow read: if signedIn();
      allow write: if isOwner(userId);
    }

    // Calificaciones: calificaciones/{partidoId}_{evaluadorId}_{evaluadoId}.
    // Solo califica quien jugó el partido, a un compañero de ese partido.
    match /calificaciones/{ratingId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.evaluadorId == uid()
        && request.resource.data.evaluadoId != uid()
        && ratingId == request.resource.data.partidoId + '_' + uid() + '_' + request.resource.data.evaluadoId
        && request.resource.data.rol in ['FIELD', 'GOALKEEPER']
        && uid() in matchData(request.resource.data.partidoId).jugadores
        && request.resource.data.evaluadoId in matchData(request.resource.data.partidoId).jugadores;
      allow delete: if false;
    }

    // ---------------------------------------------------------------- Comentarios e IA

    // Comentarios: comentarios/{partidoId}_{autorId}_{jugadorId}. Solo comenta quien
    // jugó ese partido, sobre un compañero de ese partido, y solo edita los suyos.
    match /comentarios/{commentId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.autorId == uid()
        && request.resource.data.jugadorId != uid()
        && commentId == request.resource.data.partidoId + '_' + uid() + '_' + request.resource.data.jugadorId
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 200
        && uid() in matchData(request.resource.data.partidoId).jugadores
        && request.resource.data.jugadorId in matchData(request.resource.data.partidoId).jugadores;
      allow delete: if signedIn() && (resource == null || resource.data.autorId == uid());
    }

    // Reportes de comentarios: solo se crean desde la app; se revisan en la consola.
    match /reportes/{reportId} {
      allow read, delete: if false;
      allow create, update: if signedIn()
        && request.resource.data.reportadoPor == uid()
        && reportId == request.resource.data.comentarioId + '_' + uid()
        && commentExists(request.resource.data.comentarioId);
    }

    // Resumen de IA guardado: resumenesIA/{jugadorId}. Debe apuntar a un
    // comentario real de ese jugador y tener un tamaño razonable.
    match /resumenesIA/{playerId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 1500
        && request.resource.data.cantidad is int
        && commentExists(request.resource.data.ultimoComentarioId)
        && commentData(request.resource.data.ultimoComentarioId).jugadorId == playerId;
      allow delete: if false;
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
